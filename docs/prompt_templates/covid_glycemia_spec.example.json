      "source": "Глюкоза последний результат",
      "type": "numeric"
    },
    {
      "name": "Гипергликемия >11.1 дважды",
      "source": "Гипергликемия >11,1 дважды по результатам бх крови",
      "type": "binary"
    }
  ],
