    "path": "docs/Общая таблица Ковид19.xlsx",
    "sheet": "Лист1"
  },
  "model_id": "google/gemini-2.5-flash",
  "language": "ru",
  "research_goal": "Оценить связь гликемии с летальным исходом у госпитализированных пациентов с COVID-19 и получить практические правила стратификации риска.",
  "research_questions": [
    "Связана ли гликемия при поступлении с летальным исходом?",
    "Связана ли последняя гликемия с летальным исходом?",
    "Меняется ли связь гликемии и исхода у пациентов с/без СД2?",
    "Сохраняется ли связь после поправки на тяжесть, коморбидность и лечение?"
  ],
  "outcome": {
    "name": "death",
    "source_columns": [
      "Исход",
      "Исход.1",
      "Исход.2"
    ],
    "mapping_rules": [
      "Мертв/умер/неблагоприятный -> 1",
      "Выписан/благоприятный -> 0"
    ]
  },
  "exposures": [
