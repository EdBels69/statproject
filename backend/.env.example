# Copilot LLM Configuration
# Updated: 04.02.2026

# ===== RouterAI / OpenRouter =====
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_API_URL=https://routerai.ru/api/v1/chat/completions

# Default model (fallback if role-specific not set)
GLM_MODEL=google/gemini-2.5-flash
LLM_MODEL_ID=google/gemini-2.5-flash
LLM_MODEL_FALLBACK=google/gemini-2.5-flash

# Role-based models (optional)
CLINIMETRIA_MODEL_PLANNER=google/gemini-2.5-flash
CLINIMETRIA_MODEL_PLANNER_FALLBACK=google/gemini-2.5-flash
CLINIMETRIA_MODEL_REPORT=google/gemini-2.5-flash
CLINIMETRIA_MODEL_INTERPRET=google/gemini-2.5-flash
CLINIMETRIA_MODEL_QUALITY=google/gemini-2.5-flash
CLINIMETRIA_MODEL_JSON_FIX=google/gemini-2.5-flash
COPILOT_MODEL_FALLBACK=google/gemini-2.5-flash

# RouterAI alternates (examples):
# LLM_MODEL_ID=minimax/minimax-m2.5
# LLM_MODEL_FALLBACK=z-ai/glm-5
# CLINIMETRIA_MODEL_PLANNER=qwen/qwen3.5-397b-a17b

# JSON mode for planner (if supported by provider)
CLINIMETRIA_LLM_JSON_MODE=1

# Auto-failover for RouterAI models (MiniMax/GLM/Qwen -> Gemini)
CLINIMETRIA_LLM_FAILOVER_ENABLED=1
CLINIMETRIA_MODEL_API_FALLBACK=google/gemini-2.5-flash

# ===== Z.AI (GLM direct) =====
# If you want direct GLM-4.7 with thinking mode, set:
# GLM_API_URL=https://api.z.ai/api/coding/paas/v4
# GLM_API_KEY=your-zai-key
# And use model name without slash, e.g.:
# CLINIMETRIA_MODEL_REPORT=glm-4.7
# CLINIMETRIA_MODEL_CODEGEN=glm-4.7
# CLINIMETRIA_GLM_THINKING=enabled
# CLINIMETRIA_ZAI_DIRECT=0
# ZAI_API_KEY=
# ZAI_API_URL=https://api.z.ai/api/coding/paas/v4

# ===== Backend Settings =====
PROJECT_NAME=Clinimetria
CLINIMETRIA_WORKSPACE_DIR=workspace
CLINIMETRIA_REQUIRE_DESIGN_REVIEW=1
CLINIMETRIA_REPORT_HARD_GATE_DESIGN=1
CLINIMETRIA_REPORT_HARD_GATE_METHODS=1
CLINIMETRIA_REPORT_HARD_GATE_VERIFICATION=0
CLINIMETRIA_REPORT_HARD_GATE_PROVENANCE=0
CLINIMETRIA_AGENT_ORCHESTRATOR_ENABLED=0
CLINIMETRIA_AGENT_ORCHESTRATOR_MAX_ROUNDS=10
CLINIMETRIA_LEGACY_TELEMETRY_PATH=
CLINIMETRIA_TELEMETRY_TOKEN=
CLINIMETRIA_KB_PDF_MAX_PAGES=0
CLINIMETRIA_KB_PDF_MAX_CHARS_PER_FILE=2000000
CLINIMETRIA_KB_PDF_MAX_BYTES_PER_FILE=30000000
CLINIMETRIA_KB_PDF_HARD_MAX_CHARS_PER_FILE=5000000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
